# Backend only. Copy to .env for local development; use HF Space secrets in production.
GROQ_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=pulse-medical-db
# One multimodal model for both chat and photo transcription.
AI_MODEL=qwen/qwen3.8-27b

# Same Supabase project and PUBLISHABLE key used in frontend/config.js.
# No secret/service-role key is used; the caller's JWT keeps row-level security active.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Disable photo extraction independently without selecting a second model.
PHOTO_EXTRACTION_ENABLED=true

# Comma-separated exact frontend origins. No trailing slash.
ALLOWED_ORIGINS=https://pulse-med.vercel.app,http://localhost:5500,http://127.0.0.1:5500
PORT=7860

# Optional public web evidence. Enable only after web_tools_migration.sql is applied.
WEB_TOOLS_ENABLED=false
# Keyless search needs no additional search API key. Existing GROQ_API_KEY is still required.
